<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The provider reads and edits Android's personal dictionary on the user's request. -->
    <uses-permission android:name="android.permission.READ_USER_DICTIONARY" />
    <uses-permission android:name="android.permission.WRITE_USER_DICTIONARY" />

    <!-- Unstable is a bound, offline provider; remove permissions inherited by the full IME. -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.VIBRATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.RECORD_AUDIO"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.READ_MEDIA_IMAGES"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />
    <uses-permission
        android:name="${applicationId}.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        tools:node="remove" />

    <queries tools:node="remove" />

    <!-- Replace the full keyboard application with the provider's sole Android component. -->
    <application
        android:name=".CrashLoggingApplication"
        android:allowBackup="true"
        android:label="FUTO predictive text provider"
        android:largeHeap="true"
        android:supportsRtl="true"
        tools:node="replace">

        <service
            android:name=".autocorrect.FlorisAutocorrectService"
            android:exported="true"
            android:label="FUTO predictive text">
            <intent-filter>
                <action android:name="org.florisboard.autocorrect.api.action.BIND_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="org.florisboard.autocorrect.api.PROTOCOL_VERSION"
                android:value="2" />
        </service>
    </application>
</manifest>
